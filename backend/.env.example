PORT=3001
ANTHROPIC_API_KEY=your_claude_api_key_here

# Server-only Gemini key from your own billing-enabled Google AI Studio project.
# Nano Banana 2 image generation is a paid API, not a free Gemini chat feature.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Independent, random private-beta access code: 24-512 printable ASCII characters.
# Never use an AI provider key here or put either secret in EXPO_PUBLIC_* / Git.
TRY_ON_ACCESS_TOKEN=

# Optional dedicated vision API for tagging, e.g.:
# GOOGLE_VISION_API_KEY=your_key_here
