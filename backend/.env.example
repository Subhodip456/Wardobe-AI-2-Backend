PORT=3001
ANTHROPIC_API_KEY=your_claude_api_key_here
# Server-only OpenAI project key with API billing and image-model access.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Independent, random private-beta access code: 24-512 printable ASCII characters.
# Never use the OpenAI key here, put either secret in EXPO_PUBLIC_*, or commit secrets.
TRY_ON_ACCESS_TOKEN=
# If you'd rather use a dedicated vision API for tagging (often cheaper/faster
# than a general LLM for this narrow task), add its key here too, e.g.:
# GOOGLE_VISION_API_KEY=your_key_here
